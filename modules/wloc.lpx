#!name=Apple WLOC Location Spoofer
#!desc=Modify the coordinates returned by Apple's network-based location service (WiFi/cell) | Shortcuts (recommended): Set Location https://www.icloud.com/shortcuts/182f3a014597468eb1b15b99261cdf22
#!icon=https://raw.githubusercontent.com/sodardyjiber/wloc/refs/heads/main/wloc.jpg
#!author=Yu9191 Rewrite
#!homepage=https://github.com/sodardyjiber/wloc
#!openUrl=https://github.com/sodardyjiber/wloc

[Argument]
longitude = input, "113.94114", tag=Longitude (online picker takes priority)
latitude = input, "22.544577", tag=Latitude (online picker takes priority)
accuracy = input, "25", tag=Accuracy (meters)
logLevel = select, "info", "off", "error", "warn", "debug", "all", tag=Log level

[Script]
http-response ^https?:\/\/gs-loc(-cn)?\.apple\.com\/clls\/wloc script-path=https://raw.githubusercontent.com/sodardyjiber/wloc/refs/heads/main/dist/wloc.js, requires-body=true, binary-body-mode=true, max-size=0, timeout=30
http-request ^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save script-path=https://raw.githubusercontent.com/sodardyjiber/wloc/refs/heads/main/dist/wloc-settings.js, timeout=10

[MITM]
hostname = gs-loc.apple.com, gs-loc-cn.apple.com
